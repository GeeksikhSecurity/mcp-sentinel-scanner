# Claude Code Rules for MCP Sentinel Scanner
# Security scanning tool with custom detection rules and false positive elimination

project_context:
  type: "security_scanner"
  name: "MCP Sentinel Scanner"
  version: "1.5"
  stack: "Python 3.9+, AST, Regex, Threading"
  testing_framework: "pytest, pytest-cov"
  purpose: "Defensive security analysis for Model Context Protocol servers"

permissions:
  auto_approve:
    - "lint fixes (black, isort, flake8)"
    - "type annotation improvements"
    - "test file creation/updates"
    - "documentation updates"
    - "false positive pattern additions"
    - "comment clarifications"

  require_approval:
    - "scanner core logic changes"
    - "pattern definition modifications"
    - "severity level changes"
    - "config schema changes"
    - "workflow file modifications"
    - "dependency version changes (major)"

  forbidden:
    - "deleting test files"
    - "removing security patterns"
    - "lowering security thresholds without justification"
    - "bypassing security checks"
    - "committing secrets or API keys"
    - "removing # nosec comments without review"

false_positive_elimination:
  principles:
    - "Patterns in detection rules are NOT vulnerabilities"
    - "Test files contain intentional vulnerable code"
    - "String concatenation can avoid self-detection"
    - "Context matters: location + surrounding code"

  strategies:
    string_concat: "Use 'pickle.' + 'loads' to build runtime strings"
    exclusions: "Add file/directory patterns to configs/ci_config.json"
    comments: "Add # nosec with explanation for known safe code"
    refactoring: "Move detection patterns to separate data structures"

  detection_rule_locations:
    - "src/taint_analysis.py:SINKS"
    - "src/taint_analysis.py:SOURCES"
    - "src/advanced_detection.py:DANGEROUS_FUNCTIONS"
    - "src/mcp_sentinel_scanner.py:patterns"

debugging_workflow:
  1: "Analyze: Read stack trace, error message, and relevant files"
  2: "Reproduce: Create minimal test case if possible"
  3: "Diagnose: Identify root cause and check for similar issues"
  4: "Propose: Suggest 2-3 solutions with trade-offs"
  5: "Implement: Apply least invasive fix with tests"
  6: "Verify: Run full test suite (pytest tests/ -v)"
  7: "Document: Update comments and docs as needed"

security_analysis_workflow:
  1: "Scan with current config: python -m scripts.sentinel_cli . --config configs/ci_config.json"
  2: "Review CRITICAL findings: Check if production code or false positive"
  3: "Categorize: Real vulnerability vs test code vs pattern definition"
  4: "Fix real issues: Refactor vulnerable code with secure alternatives"
  5: "Suppress false positives: Use exclusions, # nosec, or string concat"
  6: "Validate: Re-scan and verify 0 CRITICAL in production code"
  7: "Document: Add to false_positive_patterns in config"

refactor_workflow:
  1: "Scope: Clearly define what needs refactoring and why"
  2: "Branch: git checkout -b refactor/description"
  3: "Backup: Ensure clean working tree before starting"
  4: "Incremental: Make small changes, test after each"
  5: "Coverage: Maintain or improve test coverage (current: 96% core)"
  6: "Performance: Verify scan speed remains fast (57 files/sec)"
  7: "Document: Update docstrings and README if public API changes"

testing_requirements:
  coverage_threshold: "96% for core modules (src/mcp_sentinel_scanner.py, src/advanced_detection.py)"
  test_count: "52 tests minimum (current baseline)"
  test_types:
    - "Unit tests for utilities and functions"
    - "Integration tests for full scan workflows"
    - "Error handling tests for edge cases"
    - "False positive regression tests"

  commands:
    run_tests: "python -m pytest tests/ -v"
    with_coverage: "python -m pytest tests/ -v --cov=src --cov-report=term-missing"
    specific_test: "python -m pytest tests/test_scanner.py::test_name -v"

file_patterns:
  production_code: ["src/**/*.py"]
  test_code: ["tests/**/*.py"]
  config_files: ["configs/*.json", ".github/workflows/*.yml"]
  docs: ["*.md", "docs/*.md"]
  ignore_for_security_scan: ["tests/", "docs/", "examples/", "*.d.ts"]

code_style:
  formatting: "black with 100 char line length"
  imports: "sorted with isort"
  type_hints: "full annotations for public APIs"
  docstrings: "Google style for functions, classes"

  naming_conventions:
    classes: "PascalCase (e.g., MCPSentinelScanner)"
    functions: "snake_case (e.g., scan_file)"
    constants: "UPPER_SNAKE_CASE (e.g., SUPPORTED_EXTENSIONS)"
    private: "_prefix for internal methods"

security_patterns:
  priority_categories:
    - "command_injection"
    - "sql_injection"
    - "code_injection"
    - "authentication bypass"
    - "insecure_deserialization"

  avoid_patterns:
    - "eval() and exec() without sandboxing"
    - "shell=True in subprocess calls"
    - "pickle.loads() on untrusted data"
    - "String concatenation in SQL queries"
    - "Hardcoded secrets and API keys"

custom_rules_integration:
  config_file: "configs/security_rules.json"

  rule_structure:
    - "id: Unique identifier"
    - "name: Human-readable name"
    - "severity: CRITICAL/HIGH/MEDIUM/LOW"
    - "category: Vulnerability type"
    - "pattern: Regex pattern"
    - "description: What it detects"
    - "cwe: CWE mapping"
    - "recommendation: How to fix"

  adding_custom_rules:
    1: "Define rule in configs/security_rules.json"
    2: "Test pattern matches expected code"
    3: "Verify no false positives in production code"
    4: "Add to priority_categories if critical"
    5: "Document in SECURITY.md"

git_workflow:
  commit_conventions:
    feat: "New features (e.g., feat: add taint analysis)"
    fix: "Bug fixes (e.g., fix: eliminate false positive)"
    test: "Test additions (e.g., test: add error handling tests)"
    docs: "Documentation (e.g., docs: add SECURITY.md)"
    refactor: "Code refactoring (e.g., refactor: simplify pattern matching)"
    chore: "Maintenance (e.g., chore: update dependencies)"

  commit_format: |
    <type>: <short description>

    <detailed explanation>

    <footer with references>

    🤖 Generated with [Claude Code](https://claude.com/claude-code)
    Co-Authored-By: Claude <noreply@anthropic.com>

  branch_naming:
    features: "feat/description"
    fixes: "fix/description"
    security: "security/description"
    refactors: "refactor/description"

ci_cd_integration:
  workflows:
    - "CI: Test across Python 3.9-3.12"
    - "Security Scan: Self-scan with threshold blocking"

  success_criteria:
    ci: "All 52 tests pass, coverage >= 96%"
    security: "0 CRITICAL vulnerabilities in production code"

  failure_handling:
    - "Check workflow logs: gh run view <run_id> --log"
    - "Reproduce locally before fixing"
    - "Fix root cause, not symptoms"
    - "Add regression test"

prompts:
  analyze_false_positive: |
    Analyze this CRITICAL finding and determine if it's a false positive:

    File: <file_path>
    Line: <line_number>
    Pattern: <code_snippet>

    Check:
    1. Is this in a test file? (tests/)
    2. Is this a pattern definition? (SINKS, SOURCES, PATTERNS)
    3. Is this string concatenation at runtime?
    4. Does context show safe usage?

    If false positive, suggest fix:
    - Exclusion pattern
    - String concatenation
    - # nosec comment
    - Refactoring approach

  add_custom_security_rule: |
    Create a custom security rule for:

    Vulnerability: <vuln_type>
    Pattern: <regex_pattern>
    Severity: <CRITICAL/HIGH/MEDIUM/LOW>

    Steps:
    1. Add to configs/security_rules.json with unique ID
    2. Test against known vulnerable code
    3. Verify no false positives in production code
    4. Document in rule description
    5. Add test case in tests/

  optimize_scan_performance: |
    The current scan performance is 57 files/sec. Optimize while maintaining accuracy:

    1. Profile: Identify slow patterns or operations
    2. Optimize: Improve regex, reduce file I/O, better parallelization
    3. Benchmark: Compare before/after with time measurement
    4. Verify: Ensure detection quality unchanged
    5. Document: Note performance improvements in commit

  reduce_false_positives: |
    Systematically reduce false positives:

    1. Scan current codebase and collect all findings
    2. Categorize: Production bugs vs test code vs pattern definitions
    3. For each false positive:
       - Add exclusion if test/example code
       - Use string concat if pattern definition
       - Add # nosec if intentional safe code
       - Refactor if genuinely ambiguous
    4. Re-scan and verify improvements
    5. Update configs/ci_config.json with patterns

documentation_requirements:
  required_for:
    - "New detection patterns"
    - "Configuration changes"
    - "Custom rules"
    - "False positive handling"
    - "Security policies"

  formats:
    code: "Google-style docstrings"
    api: "README.md usage examples"
    security: "SECURITY.md for vulnerability disclosure"
    architecture: "ASCII diagrams in VISUAL_GUIDE.md"

monitoring_and_validation:
  pre_commit_checks:
    - "Run tests: pytest tests/ -v"
    - "Check types: mypy src/ (if configured)"
    - "Lint: flake8 src/ tests/"
    - "Format: black --check src/ tests/"

  pre_push_checks:
    - "Full test suite with coverage"
    - "Security self-scan"
    - "Check no secrets committed"
    - "Verify workflows would pass"

  post_deployment:
    - "Monitor GitHub Actions for CI/Security Scan status"
    - "Check SARIF upload to GitHub Security tab"
    - "Review any new CRITICAL findings"

special_considerations:
  mcp_specific:
    - "MCP servers have unique attack surface (tool execution, context access)"
    - "Authentication bypass patterns differ from web apps"
    - "Taint analysis critical for tool parameter validation"
    - "Environment variable access is untrusted source"

  scanner_self_awareness:
    - "Scanner detects patterns it uses for detection"
    - "Must use techniques to avoid self-flagging"
    - "Test files intentionally contain vulnerabilities"
    - "Pattern definitions are not vulnerabilities"

best_practices:
  1: "Defensive security only - never assist with offensive tools"
  2: "High confidence patterns preferred over broad catches"
  3: "Context-aware detection reduces false positives"
  4: "Test coverage prevents regression"
  5: "Clear documentation aids future maintenance"
  6: "Performance matters - scan should be fast"
  7: "SARIF compliance enables IDE integration"
  8: "Custom rules extend scanner capabilities"
  9: "False positive elimination improves adoption"
  10: "Security gate should not block on test code"

final_notes: |
  MCP Sentinel Scanner is a defensive security tool that must maintain
  high accuracy to be useful. False positives erode trust, so every
  finding should be actionable.

  Claude Code should:
  - Prioritize fixing real vulnerabilities over reducing noise
  - Use multiple strategies to eliminate false positives
  - Maintain test coverage while improving scanner
  - Document patterns and decisions for future developers
  - Treat security findings seriously with proper investigation

  Remember: The scanner protects MCP servers. Its own security
  and accuracy are paramount.
