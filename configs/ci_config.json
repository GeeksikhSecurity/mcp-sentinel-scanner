{
  "exclude": [
    "node_modules",
    "*.d.ts",
    "dist",
    "build",
    ".git",
    "vendor",
    "__pycache__",
    "*.pyc",
    ".venv",
    ".pytest_cache",
    "htmlcov",
    "vulnerable_test",
    "tests/"
  ],
  "severity_threshold": "LOW",
  "parallel_workers": 4,
  "false_positive_patterns": [
    {
      "file": "src/taint_analysis.py",
      "pattern": "SINKS|SOURCES",
      "reason": "Detection rule definitions"
    },
    {
      "file": "src/advanced_detection.py",
      "pattern": "DANGEROUS_FUNCTIONS|PATTERNS",
      "reason": "Detection rule definitions"
    }
  ]
}
